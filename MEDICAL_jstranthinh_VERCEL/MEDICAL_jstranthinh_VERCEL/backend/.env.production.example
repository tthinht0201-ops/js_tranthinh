NODE_ENV=production
PORT=5000
# Neon pooled URL - dùng cho backend Vercel chạy thực tế
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DATABASE?sslmode=require
# Neon direct URL - dùng cho Prisma migrations/CLI
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters-long
# Multiple frontend domains may be comma-separated when needed.
CORS_ORIGIN=https://YOUR-FRONTEND-DOMAIN.vercel.app
PATIENT_CANCELLATION_MIN_HOURS=2
# Optional AI integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
