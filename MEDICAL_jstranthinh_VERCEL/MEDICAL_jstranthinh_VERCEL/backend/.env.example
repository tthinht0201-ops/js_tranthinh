NODE_ENV=development
PORT=5000
# Runtime application connection. Local PostgreSQL is already a direct connection.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/medical_booking
# Optional locally; if omitted, Prisma CLI falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/medical_booking
JWT_SECRET=change-this-local-jwt-secret-at-least-32-characters-long
CORS_ORIGIN=http://localhost:5173
PATIENT_CANCELLATION_MIN_HOURS=2
# Optional AI integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
